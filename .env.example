# =============================================================================
# CBT Memory Agent — Environment Variables (EXAMPLE)
# Salin file ini menjadi .env lalu isi nilai asli. JANGAN commit .env ke git.
# =============================================================================

# --- CockroachDB Connection ---
CRDB_HOST=your-cluster-xxxx.region.cockroachlabs.cloud
CRDB_PORT=26257
CRDB_DATABASE=defaultdb
CRDB_USERNAME=your-user
CRDB_PASSWORD=your-password
CRDB_CLUSTER_NAME=your-cluster-name
CRDB_CLUSTER_ID=your-cluster-id
CRDB_CONNECTION_URL=postgresql://user:pass@host:26257/defaultdb?sslmode=verify-full

# --- CockroachDB Cloud API Key (Service Account) ---
CCLOUD_API_KEY=CCDB1_...
# API key khusus untuk Managed MCP Server (read-only). Bisa = CCLOUD_API_KEY.
# Dipakai header Authorization di mcp/mcp-config.json + .mcp.json.
CCLOUD_MCP_API_KEY=CCDB1_...
# Reflection loop (lambda/lib/mcp.ts): fetch timeout untuk step MCP read-only
# (default 5000ms). Lambda sudah punya CCLOUD_API_KEY, jadi step ini live di prod.
MCP_CLUSTER_ID=87275047-fbf8-4f18-8b8d-a5ff97a335e3
MCP_FETCH_TIMEOUT_MS=5000
# Reflection loop (lambda/lib/clusterHealth.ts): timeout health gate cluster
# (ccloud CLI + REST fallback). Total failure → {healthy:true, skipped:true}.
CCLOUD_HEALTH_TIMEOUT_MS=10000

# --- OpenRouter (LLM chat + embeddings) ---
OPENROUTER_API_KEY=sk-or-v1-...

# --- Hackathon ---
HACKATHON_TRACK="CockroachDB x AWS"
DEADLINE=2026-08-18

# --- Frontend (Vite) ---
# Base URL API backend. Kosongkan untuk proxy same-origin (/api/v1) via nginx.
VITE_API_URL=/api/v1

# OpenTelemetry (browser tracing → relay /api/v1/telemetry, token server-side)
# Browser meng-ekspor 100% span boundary; sampling head dilakukan di relay.
VITE_OTEL_ENABLED=false
VITE_OTEL_TRACE_ENDPOINT=/api/v1/telemetry
VITE_OTEL_SAMPLING_RATIO=1.0

# Head sampling ratio di relay POST /api/v1/telemetry (default 1.0 = ekspor semua).
OTEL_RELAY_SAMPLING_RATIO=1.0

# --- Docker Compose ---
# Port host untuk container nginx frontend.
APP_PORT=3000

# Backend upstream untuk proxy nginx /api/v1 (Lambda Function URL).
# Kosongkan untuk mode frontend-only.
BACKEND_URL=https://xxxxxxxx.lambda-url.ap-southeast-3.on.aws/

# --- AWS (SSO/Identity Center) ---
# Profile di ~/.aws/config (login_session + region). Dipakai scripts/aws-login.sh.
AWS_PROFILE=aws-x-cdb
AWS_REGION=ap-southeast-3
AWS_ACCOUNT_ID=926375049642

# --- Resend (magic-link email) ---
# Bebas diisi hanya di .env lokal (git-ignored). Di deploy, set env Lambda dengan nilai asli.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev

# --- Grafana Cloud (OpenTelemetry OTLP) ---
# Instance: stack-<id>-otlp-write-<name> · JANGAN commit. Hanya HTTP http/protobuf.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
GRAFANA_INSTANCE_ID=<instance-id>
GRAFANA_OTLP_TOKEN=glc_...
# Basic header = base64("<instance_id>:<token>"). Python butuh "Basic%20" ketimbang "Basic ".
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64>
# Tempo query API (read-only token, user = org user id) — untuk verifikasi trace
GRAFANA_TEMPO_URL=https://tempo-prod-<n>-prod-<region>.grafana.net/tempo
GRAFANA_TEMPO_USER=<org-user-id>
GRAFANA_TEMPO_TOKEN=glc_...ht-read-tempo-key...
# Grafana Cloud stack URL + service account token (role Admin) untuk provisioning
# dashboard/datasource (scripts/grafana-provision.sh). Token dibuat di dalam instance
# Grafana (Administration → Service accounts) — access policy hanya gate data-plane.
GRAFANA_URL=https://<stack>.grafana.net
GRAFANA_API_KEY=glsa_...
# --- AWS PrivateLink (VPC → Grafana Cloud, region ap-southeast-3) ---
GRAFANA_OTLP_PRIVATELINK_SERVICE=com.amazonaws.vpce.<region>.vpce-svc-<id>
GRAFANA_OTLP_PRIVATELINK_DNS=<dns>.vpce.grafana.net
GRAFANA_OTLP_PRIVATELINK_AZ=<az-ids>
# --- Arize Phoenix (self-hosted EC2, LLM observability) ---
# UI: http://<ec2-ip>:6006 ; OTLP/HTTP intake SAMA dengan port UI (6006/v1/traces).
# Auth WAJIB karena PHOENIX_ENABLE_AUTH=true → Authorization=Bearer <system-api-key>.
# Key dibuat di UI Phoenix (Settings → API keys); hanya tampil sekali. LAMBDA memakai
# exporter protobuf (http/protobuf) karena Phoenix tidak menerima OTLP JSON.
PHOENIX_OTLP_ENDPOINT=http://<ec2-ip>:6006
PHOENIX_OTLP_HEADERS=Authorization=Bearer <system-api-key>
