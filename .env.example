# =============================================================================
# CBT Memory Agent — Environment Variables (EXAMPLE)
# Salin file ini menjadi .env lalu isi nilai asli. JANGAN commit .env ke git.
# =============================================================================

# --- CockroachDB Connection ---
CRDB_HOST=your-cluster-xxxx.region.cockroachlabs.cloud
CRDB_PORT=26257
CRDB_DATABASE=defaultdb
CRDB_USERNAME=your-user
CRDB_PASSWORD=your-password
CRDB_CLUSTER_NAME=your-cluster-name
CRDB_CLUSTER_ID=your-cluster-id
CRDB_CONNECTION_URL=postgresql://user:pass@host:26257/defaultdb?sslmode=verify-full

# --- CockroachDB Cloud API Key (Service Account) ---
CCLOUD_API_KEY=CCDB1_...

# --- OpenRouter (LLM chat + embeddings) ---
OPENROUTER_API_KEY=sk-or-v1-...

# --- Hackathon ---
HACKATHON_TRACK="CockroachDB x AWS"
DEADLINE=2026-08-18

# --- Frontend (Vite) ---
# Base URL API backend. Kosongkan untuk proxy same-origin (/api/v1) via nginx.
VITE_API_URL=/api/v1

# --- Docker Compose ---
# Port host untuk container nginx frontend.
APP_PORT=3000

# Backend upstream untuk proxy nginx /api/v1 (Lambda Function URL).
# Kosongkan untuk mode frontend-only.
BACKEND_URL=https://xxxxxxxx.lambda-url.ap-southeast-3.on.aws/

# --- AWS (SSO/Identity Center) ---
# Profile di ~/.aws/config (login_session + region). Dipakai scripts/aws-login.sh.
AWS_PROFILE=aws-x-cdb
AWS_REGION=ap-southeast-3
AWS_ACCOUNT_ID=926375049642

# --- Resend (magic-link email) ---
# Bebas diisi hanya di .env lokal (git-ignored). Di deploy, set env Lambda dengan nilai asli.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev
